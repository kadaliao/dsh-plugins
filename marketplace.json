    {
      "name": "@kadaliao/dsh-prompt-en",
      "title": {
        "en": "Prompt EN",
        "zh": "Prompt EN"
      },
      "description": {
        "en": "English under every prompt: a translation when you write in another language, a correction or other ways to say it when you write in English, and a vocabulary book to review what it taught.",
        "zh": "在每条 prompt 下方写一行英文：用其他语言写的给出英文，用英文写的给出纠错或更地道的说法；教过你的说法收进生词本复习。"
      },
