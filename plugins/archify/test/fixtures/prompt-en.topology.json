{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "prompt-en 运行时架构",
    "subtitle": "DeepSeek Harness 插件的 Host 半与 Client 半：一条 prompt 如何变成对话里的一行英文和一张生词卡",
    "locale": "zh-CN",
    "output": "pe-run2-first.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "translate",
        "label": "翻译与审阅链路",
        "focus": [
          "user",
          "session",
          "watch",
          "queue",
          "llm",
          "cache",
          "state",
          "conversation"
        ],
        "note": "用户 prompt 经事件总线进入插件，最多两次并发调一次模型，答案写入磁盘缓存，页面轮询后画成一行。"
      },
      {
        "id": "vocab",
        "label": "生词本链路",
        "focus": [
          "translate",
          "queue",
          "llm",
          "collect",
          "store",
          "book",
          "vocabroute",
          "vocabpane"
        ],
        "note": "审阅直接解析出卡片；译文另发一次挑选请求，挑出的卡片经五个路由在右侧栏复习。"
      }
    ]
  },
  "components": [
    {
      "id": "user",
      "type": "external",
      "label": "你",
      "sublabel": "在 Web 页面里输入 prompt"
    },
    {
      "id": "session",
      "type": "backend",
      "label": "Session",
      "sublabel": "对话事件日志与快照"
    },
    {
      "id": "watch",
      "type": "backend",
      "label": "session/event 监听",
      "sublabel": "过滤子代理、斜杠命令、非 user 来源"
    },
    {
      "id": "queue",
      "type": "backend",
      "label": "classify + 队列",
      "sublabel": "判定 translate / review，最多 2 个并发"
    },
    {
      "id": "cache",
      "type": "database",
      "label": "答案缓存",
      "sublabel": "$DSH_HOME/cache/prompt-en/cache.json",
      "tag": "按文本去重 · 500ms 写"
    },
    {
      "id": "llm",
      "type": "cloud",
      "label": "LLM 服务",
      "sublabel": "ctx.get('llm').stream · 60s 超时",
      "tag": "空回复重试一次"
    },
    {
      "id": "translate",
      "type": "backend",
      "label": "翻译 / 审阅",
      "sublabel": "buildTranslate / buildReview / parseReview"
    },
    {
      "id": "routes",
      "type": "backend",
      "label": "七个回环 JSON 路由",
      "sublabel": "webServer.register · kind: exact",
      "tag": "/__dsh_prompt_en/*"
    },
    {
      "id": "state",
      "type": "backend",
      "label": "/state 读取",
      "sublabel": "按 server 串过滤；空则用快照回补"
    },
    {
      "id": "conversation",
      "type": "frontend",
      "label": "对话里的一行",
      "sublabel": "PromptEnRow · chat 节点 · anchorSeq + 0.1"
    },
    {
      "id": "client",
      "type": "frontend",
      "label": "浏览器 Client",
      "sublabel": "每会话一个轮询器：700 / 2500ms"
    },
    {
      "id": "collect",
      "type": "backend",
      "label": "生词收集",
      "sublabel": "onAnswered → collect · 旁路不阻塞队列"
    },
    {
      "id": "store",
      "type": "backend",
      "label": "生词本存储",
      "sublabel": "createBook · Leitner 盒 1/3/7/16/35/90 天",
      "tag": "最多 1000 张"
    },
    {
      "id": "book",
      "type": "database",
      "label": "生词本文件",
      "sublabel": "$DSH_HOME/cache/prompt-en/vocab.json",
      "tag": "cards · done · nudgedAt"
    },
    {
      "id": "vocabroute",
      "type": "backend",
      "label": "生词本 5 个路由",
      "sublabel": "/vocab · /list · /grade · /drop · /notice",
      "tag": "外加 /import、/answer、/debug"
    },
    {
      "id": "vocabpane",
      "type": "frontend",
      "label": "「生词本」侧栏标签页",
      "sublabel": "VocabPane + VocabNotice 提示条"
    }
  ],
  "boundaries": [
    {
      "kind": "security-group",
      "label": "Host 半 index.js · lib",
      "wraps": [
        "session",
        "watch",
        "queue",
        "cache",
        "translate",
        "routes",
        "state",
        "collect",
        "store",
        "vocabroute"
      ]
    },
    {
      "kind": "security-group",
      "label": "Client 半 client.js",
      "wraps": [
        "conversation",
        "client",
        "vocabpane"
      ]
    }
  ],
  "connections": [
    {
      "id": "send-prompt",
      "from": "user",
      "to": "session",
      "label": "发送 prompt",
      "variant": "emphasis"
    },
    {
      "id": "event-feed",
      "from": "session",
      "to": "watch",
      "label": "user/message",
      "variant": "emphasis"
    },
    {
      "id": "enqueue",
      "from": "watch",
      "to": "queue",
      "label": "入队"
    },
    {
      "id": "call-llm",
      "from": "queue",
      "to": "llm",
      "label": "messages + system"
    },
    {
      "id": "answer-back",
      "from": "llm",
      "to": "translate",
      "label": "流式回包"
    },
    {
      "id": "store-answer",
      "from": "translate",
      "to": "cache",
      "label": "记住答案"
    },
    {
      "id": "state-serves",
      "from": "state",
      "to": "cache",
      "label": "读缓存"
    },
    {
      "id": "route-reads-state",
      "from": "routes",
      "to": "state",
      "label": "GET /state"
    },
    {
      "id": "client-polls",
      "from": "client",
      "to": "routes",
      "label": "轮询 /state",
      "variant": "emphasis"
    },
    {
      "id": "row-renders",
      "from": "state",
      "to": "conversation",
      "label": "items"
    },
    {
      "id": "collect-sends",
      "from": "collect",
      "to": "llm",
      "label": "挑短语"
    },
    {
      "id": "collect-files",
      "from": "collect",
      "to": "store",
      "label": "产出卡片"
    },
    {
      "id": "persist-book",
      "from": "store",
      "to": "book",
      "label": "存 250ms 写"
    },
    {
      "id": "vocab-regrade",
      "from": "vocabroute",
      "to": "store",
      "label": "评分 / 删除"
    },
    {
      "id": "load-book",
      "from": "store",
      "to": "book",
      "label": "启动读回",
      "variant": "dashed"
    },
    {
      "id": "pane-calls",
      "from": "vocabpane",
      "to": "vocabroute",
      "label": "复习请求"
    },
    {
      "id": "import-reads",
      "from": "vocabroute",
      "to": "cache",
      "label": "/import 读缓存",
      "variant": "dashed"
    },
    {
      "id": "import-session",
      "from": "vocabroute",
      "to": "session",
      "label": "找回原句",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "这一行只是给你看的",
      "items": [
        "插件不写会话日志，也不改动模型看到的内容；模型收到的仍是你原样输入的 prompt",
        "行挂在 prompt 之后（anchorSeq + 0.1），停在 input 层级，不会被「过程」折叠收起"
      ]
    },
    {
      "dot": "emerald",
      "title": "翻译 / 审阅判定",
      "items": [
        "先去掉宿主写给模型的 <system-reminder>，再把代码块和日志折叠成 [[M1]] 标签",
        "外文字母 ≥ 2 个 → 翻译；否则英文词 ≥ 3 个 → 审阅；短句和斜杠命令直接跳过",
        "答案按 prompt 文本的哈希去重缓存，重复发「继续」不再调用模型"
      ]
    },
    {
      "dot": "violet",
      "title": "模型请求",
      "items": [
        "provider / model 依次取配置 → 会话自身 → profile 默认",
        "同时最多 2 个在途请求，每个 60 秒超时，空回复重试一次",
        "reviewEnglish / collectVocab 为 false 时对应环节不触发"
      ]
    },
    {
      "dot": "amber",
      "title": "生词本",
      "items": [
        "审阅：从 FIX / NOTE 行解析「原句 → 更好」卡片，不再额外请求",
        "译文：另发一次挑选请求，产出的短语和句型必须在原文和译文里都能找到",
        "最熟且最老的卡片先删；同一张 fix 卡再犯一次退回第 0 盒"
      ]
    }
  ]
}
