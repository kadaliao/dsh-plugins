{
  "name": "@kadaliao/dsh-archify",
  "version": "0.1.0",
  "type": "module",
  "description": "Archify for DeepSeek Harness: ask for an architecture, workflow, sequence, data-flow, state, ER, class, tree, timeline or waterfall diagram, or a one-page explainer, and get a checked interactive page right in the conversation. Bundles the Archify skill and renders it with the Harness's own runtime, no Node.js install needed.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "skill/SKILL.md",
    "archify/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadaliao/dsh-plugins.git",
    "directory": "plugins/archify"
  },
  "homepage": "https://github.com/kadaliao/dsh-plugins/tree/main/plugins/archify",
  "license": "MIT AND Apache-2.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "archify",
    "diagram",
    "architecture-diagram",
    "flowchart",
    "sequence-diagram",
    "erd",
    "skill"
  ]
}
